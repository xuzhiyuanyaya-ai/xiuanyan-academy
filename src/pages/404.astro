---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面未找到">
  <main class="max-w-2xl mx-auto px-4 py-32 text-center">
    <div class="text-6xl mb-6">404</div>
    <h1 class="text-2xl font-bold mb-4">页面未找到</h1>
    <p class="text-[var(--color-notion-gray-text)] mb-8">
      你访问的页面不存在，可能已被移动或删除。
    </p>
    <a
      href="/"
      class="inline-block px-4 py-2 bg-[var(--color-accent)] text-white rounded hover:opacity-90 transition-opacity text-sm font-medium"
    >
      返回首页
    </a>
  </main>
</BaseLayout>
