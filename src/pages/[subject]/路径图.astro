---
import SubjectLayout from '../../layouts/SubjectLayout.astro';

export async function getStaticPaths() {
  return [
    { params: { subject: 'liuyao' } },
    { params: { subject: 'bazi' } },
    { params: { subject: 'yijing' } },
    { params: { subject: 'qimen' } },
    { params: { subject: 'liuren' } },
    { params: { subject: 'fengshui' } },
  ];
}

const { subject } = Astro.params;
const subjectNames: Record<string, string> = {
  liuyao: '六爻', bazi: '八字', yijing: '易经', qimen: '奇门', liuren: '六壬', fengshui: '风水',
};
const name = subjectNames[subject] ?? subject;

const menuItems = [
  { label: '科目介绍', href: `/${subject}` },
  { label: '练习题', href: `/${subject}/练习题` },
  { label: '案例库', href: `/${subject}/案例库` },
];

// 六爻 real milestones (from 京房学习路径图)
const liuyaoMilestones = [
  {
    id: 'm1',
    title: '① 装卦',
    description: '掌握月日干支、纳甲、世应、六亲、六神、动变完整装卦流程。背诵纳甲口诀，八宫卦世应位置歌诀。',
    checkpoint: '5分钟内完成任意陌生卦象的完整装卦',
    reference: '《六爻基础概念》·《断卦流程学习》',
  },
  {
    id: 'm2',
    title: '② 世应定位',
    description: '理解世爻（问事者）、应爻（对方/环境/结果）的定义。掌握八宫卦世应歌诀，分析世应之间六种基本关系。',
    checkpoint: '准确标注任意卦世应位置与五行生克关系',
    reference: '《世应体系》·《世应生克与用神取法》',
  },
  {
    id: 'm3',
    title: '③ 六亲配置',
    description: '掌握父母、兄弟、子孙、妻财、官鬼五大六亲的生克循环与象意。给定日干推导任意地支六亲属性。',
    checkpoint: '给定日干能推导任意地支的六亲属性',
    reference: '《六亲详解》·《六亲占事》',
  },
  {
    id: 'm4',
    title: '④ 六神配置',
    description: '背诵日干配六神歌诀（甲乙日主起青龙……）。掌握六神类象与六亲×六神联合分析原则。',
    checkpoint: '能绘制六神速查表并进行六亲×六神联合断卦',
    reference: '《六神体系》',
  },
  {
    id: 'm5',
    title: '⑤ 旺衰判断',
    description: '月令定旺衰是六爻核心技术。掌握月令五行旺衰表、十二长生诀、日辰加持规则，综合判断用神强弱。',
    checkpoint: '能综合月令+日辰+动变判断用神最终旺衰',
    reference: '《太岁与月破》·《旺衰判断专项练习（15题）》',
  },
  {
    id: 'm6',
    title: '⑥ 用神选取',
    description: '用神是所问之事对应的六亲爻。掌握六亲取用歌诀、常见占事用神速查表，处理用神不现（借伏神）和两现情况。',
    checkpoint: '面对陌生占问能在30秒内确定用神',
    reference: '《六亲占事》·《世应生克与用神取法》',
  },
  {
    id: 'm7',
    title: '⑦ 动变分析',
    description: '动爻是事物变化焦点。分析独发/多动之卦，判断变爻回头生克、化进化退，处理伏神飞神关系。',
    checkpoint: '能完整分析动变链条并判断事态发展方向',
    reference: '《动变法则》·《进神退神与化进化退》',
  },
  {
    id: 'm8',
    title: '⑧ 独立断卦',
    description: '独立完成：取用神→观世应→判旺衰→看动变→参六神→定吉凶→推应期 全流程，面对真实占问给出清晰判断。',
    checkpoint: '独立完成真实占问全流程并事后验证',
    reference: '《占验案例分析》·《教学案例库（8案例）》',
  },
];

// Placeholder milestones for other subjects
const placeholderMilestones = [
  { id: 'p1', title: '① 基础理论', description: '掌握本学科核心概念与基础框架', checkpoint: '完成基础概念学习', reference: '' },
  { id: 'p2', title: '② 进阶技能', description: '深入理解本学科核心技能与方法', checkpoint: '完成进阶内容学习', reference: '' },
  { id: 'p3', title: '③ 实战应用', description: '在真实场景中应用所学，独立分析', checkpoint: '完成实战练习', reference: '' },
];

const milestones = subject === 'liuyao' ? liuyaoMilestones : placeholderMilestones;
---

<SubjectLayout title={`${name} - 路径图`} currentPath={`/${subject}`} sidebarItems={menuItems}>
  <h1 class="text-2xl font-bold mb-2">{name} 学习路径图</h1>
  <p class="text-[var(--color-notion-gray-text)] mb-2">
    {subject === 'liuyao'
      ? '六爻从"会装卦"到"会断卦"完整里程碑，共 8 个核心节点'
      : '本学科学习里程碑，持续更新中'}
  </p>
  {subject === 'liuyao' && (
    <p class="text-xs text-[var(--color-notion-gray-text)] mb-8">
      制定：2026-10-19　来源：京房六爻学习路径图
    </p>
  )}

  <div class="relative">
    <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-[var(--color-notion-border)]"></div>
    <div class="space-y-8">
      {milestones.map((m, idx) => (
        <div class="relative pl-12" data-milestone-id={m.id}>
          <div class="milestone-dot absolute left-0 w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold border-2 bg-white text-[var(--color-notion-gray-text)] border-[var(--color-notion-border)]">
            {idx + 1}
          </div>
          <div class="milestone-card p-4 border border-[var(--color-notion-border)] rounded-lg bg-white hover:border-[var(--color-accent)] transition-all">
            <h3 class="font-semibold mb-1">{m.title}</h3>
            <p class="text-sm text-[var(--color-notion-gray-text)] mb-2">{m.description}</p>
            <div class="flex flex-wrap gap-2 text-xs">
              <span class="px-2 py-0.5 bg-green-50 text-green-700 rounded">过关标准：{m.checkpoint}</span>
              {m.reference && <span class="px-2 py-0.5 bg-blue-50 text-blue-700 rounded">参考：{m.reference}</span>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <script>
    import { getSubjectProgress } from '../../components/ProgressStore.ts';
    const subjectId = window.location.pathname.split('/')[1] || 'liuyao';
    try {
      const progress = getSubjectProgress(subjectId);
      document.querySelectorAll('[data-milestone-id]').forEach(el => {
        const id = el.dataset.milestoneId!;
        const dot = el.querySelector('.milestone-dot');
        const card = el.querySelector('.milestone-card') as HTMLElement;
        if (progress.completedPaths.includes(id)) {
          dot?.classList.add('bg-[var(--color-accent)]', 'text-white', 'border-[var(--color-accent)]');
          dot!.textContent = '✓';
          card?.classList.add('border-[var(--color-accent)]', 'bg-blue-50');
        }
      });
    } catch (e) {}
  </script>
</SubjectLayout>
