---
import SubjectLayout from '../../layouts/SubjectLayout.astro';
import { marked } from 'marked';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// Configure marked for safe rendering
marked.setOptions({ breaks: true, gfm: true });

export async function getStaticPaths() {
  return [
    { params: { subject: 'liuyao' } },
    { params: { subject: 'bazi' } },
    { params: { subject: 'yijing' } },
    { params: { subject: 'qimen' } },
    { params: { subject: 'liuren' } },
    { params: { subject: 'fengshui' } },
  ];
}

const { subject } = Astro.params;
const subjectNames: Record<string, string> = {
  liuyao: '六爻', bazi: '八字', yijing: '易经', qimen: '奇门', liuren: '六壬', fengshui: '风水',
};
const name = subjectNames[subject] ?? subject;

const menuItems = [
  { label: '科目介绍', href: `/${subject}` },
  { label: '练习题', href: `/${subject}/练习题` },
  { label: '案例库', href: `/${subject}/案例库` },
];

// Load reference note content for liuyao (parsed as HTML)
function loadRef(filename: string): string {
  try {
    const base = resolve(process.cwd(), 'src/content/liuyao/references', filename);
    const raw = readFileSync(base, 'utf-8');
    const content = raw.replace(/^---[\s\S]*?---\n/, '');
    return marked.parse(content) as string;
  } catch {
    return '';
  }
}

const refNotes = {
  '世应关系': loadRef('京房_六爻_36-六爻世应关系精义.md'),
  '六亲通变': loadRef('六亲通变笔记.md'),
};

// Real 8 milestones for liuyao derived from 六爻学习路径图.md
const milestones = subject === 'liuyao' ? [
  {
    id: 'm1',
    title: '① 装卦',
    description: '掌握五行生克、八卦象意、纳甲体系——将铜钱摇出的六个爻按规则配上干支、六亲、六神、世应，形成完整卦盘',
    completed: false,
    checkpoints: [
      '能将任意六爻卦完整排出：月日干支 → 卦象 → 纳甲 → 定世应 → 安六亲 → 配六神 → 标动爻 → 排变卦',
      '背诵纳甲口诀：乾宫六爻纳甲戊，上世五爻午火属',
      '能在5分钟内完成一个陌生卦象的完整装卦',
    ],
    references: [
      { label: '📖 六爻世应关系精义', content: refNotes['世应关系'] },
      { label: '📖 六亲通变笔记', content: refNotes['六亲通变'] },
    ],
  },
  {
    id: 'm2',
    title: '② 世应定位',
    description: '世爻代表问事者本人（"我"），应爻代表对方、环境、结果（"他"）——世应关系是六爻分析人事的骨架',
    completed: false,
    checkpoints: [
      '能说出世爻与应爻的基本定义与代表含义',
      '能背诵世应位置歌诀',
      '能判断世应之间的六种基本关系：相生、相克、比和、相冲、相合、相刑',
    ],
    references: [
      { label: '📖 六爻世应关系精义', content: refNotes['世应关系'] },
    ],
  },
  {
    id: 'm3',
    title: '③ 六亲配置',
    description: '六亲是以日干为"我"，通过五行生克关系推导出的父母、兄弟、子孙、妻财、官鬼五大类别——六亲是六爻论事的"词汇表"',
    completed: false,
    checkpoints: [
      '能背诵六亲五行本源歌：木生火是父母，木比木是兄弟……',
      '能准确说出五种六亲的正面类象与负面类象',
      '能绘制六亲生克循环图',
    ],
    references: [
      { label: '📖 六亲通变笔记', content: refNotes['六亲通变'] },
    ],
  },
  {
    id: 'm4',
    title: '④ 六神配置',
    description: '六神（青龙、朱雀、勾陈、螣蛇、白虎、玄武）是以日干为基准循环配入六爻的辅助信息，为六亲"染色"',
    completed: false,
    checkpoints: [
      '能背诵日干配六神歌：甲乙日主起青龙，丙丁日起朱雀从……',
      '能准确说出六神的正面与负面类象',
      '能说明六神与六亲联合分析的基本原则',
    ],
    references: [],
  },
  {
    id: 'm5',
    title: '⑤ 旺衰判断',
    description: '判断某一爻在月令、日辰加持下的旺、相、休、囚、死状态——旺衰直接决定吉凶',
    completed: false,
    checkpoints: [
      '能背诵月令五行旺衰表：木旺在春、火旺在夏、金旺在秋、水旺在冬、土旺在四季末',
      '能准确判断任意地支在任意月令下的十二长生状态',
      '能综合月令+日辰+动变，判断用神的最终旺衰',
    ],
    references: [],
  },
  {
    id: 'm6',
    title: '⑥ 用神选取',
    description: '用神是所问之事对应的六亲爻——选对了用神，判断才有根基；选错了，一切皆错',
    completed: false,
    checkpoints: [
      '能背诵六亲取用歌',
      '能准确说出常见占事（求财、婚姻、疾病、官运、出行）的用神选取规则',
      '能处理"用神不现"的情况',
    ],
    references: [],
  },
  {
    id: 'm7',
    title: '⑦ 动变分析',
    description: '动爻是六爻的心脏——通过分析动爻的生克、回头生克、化进化退，判断事情发展方向与结果',
    completed: false,
    checkpoints: [
      '能准确识别动爻（老阳○、老阴×）与静爻',
      '能分析独发之卦与多动之卦的断法差异',
      '能判断变爻对动爻的回头生克',
    ],
    references: [],
  },
  {
    id: 'm8',
    title: '⑧ 独立断卦',
    description: '面对真实占问，能独立完成：取用神→观世应→判旺衰→看动变→参六神→定吉凶→推应期 完整流程',
    completed: false,
    checkpoints: [
      '面对陌生占问，能在3分钟内完成完整断卦流程，不查资料独立完成',
      '能给出清晰的吉凶判断',
      '能推算出合理的应期',
    ],
    references: [],
  },
] : [
  { id: 'm1', title: '基础理论', description: '掌握核心概念', completed: false, checkpoints: [], references: [] },
  { id: 'm2', title: '进阶应用', description: '深化理解', completed: false, checkpoints: [], references: [] },
  { id: 'm3', title: '实战练习', description: '案例分析', completed: false, checkpoints: [], references: [] },
];
---

<SubjectLayout title={`${name} - 路径图`} currentPath={`/${subject}`} sidebarItems={menuItems}>
  <h1 class="text-2xl font-bold mb-2">{name} 学习路径图</h1>
  <p class="text-[var(--color-notion-gray-text)] mb-8">8个核心里程碑，从"会装卦"到"会断卦"· 点击展开查看参考资料原文</p>

  <div class="relative">
    <!-- Vertical timeline -->
    <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-[var(--color-notion-border)]"></div>
    <div class="space-y-6">
      {milestones.map((m, idx) => (
        <div class="relative pl-12" data-milestone-id={m.id}>
          <div class={`absolute left-0 w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold border-2 ${
            m.completed
              ? 'bg-[var(--color-accent)] text-white border-[var(--color-accent)]'
              : 'bg-white text-[var(--color-notion-gray-text)] border-[var(--color-notion-border)]'
          }`}>
            {m.completed ? '✓' : idx + 1}
          </div>

          <!-- Milestone card -->
          <div class={`p-5 border rounded-lg ${
            m.completed ? 'border-[var(--color-accent)] bg-blue-50' : 'border-[var(--color-notion-border)] bg-white'
          }`}>
            <h3 class="font-semibold text-base mb-1">{m.title}</h3>
            <p class="text-sm text-[var(--color-notion-gray-text)] mb-3">{m.description}</p>

            <!-- Checkpoints -->
            {m.checkpoints.length > 0 && (
              <div class="mb-3">
                <p class="text-xs font-medium text-[var(--color-notion-gray-text)] mb-1.5">过关标准</p>
                <ul class="space-y-1">
                  {m.checkpoints.map((cp: string) => (
                    <li class="flex items-start gap-2 text-sm text-[var(--color-notion-text)]">
                      <span class="text-[var(--color-accent)] mt-0.5">✓</span>
                      <span>{cp}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Reference notes — collapsible inline content -->
            {m.references.length > 0 && (
              <div class="mt-3 border-t border-[var(--color-notion-border)] pt-3">
                <p class="text-xs font-medium text-[var(--color-notion-gray-text)] mb-2">参考资料（点击展开）</p>
                <div class="space-y-2">
                  {m.references.map((ref: { label: string; content: string }) => (
                    <details class="group rounded border border-[var(--color-notion-border)] overflow-hidden">
                      <summary class="flex items-center gap-2 px-3 py-2 cursor-pointer text-sm font-medium text-[var(--color-notion-text)] hover:bg-[var(--color-notion-gray)] transition-colors list-none">
                        <span class="text-[var(--color-accent)] transition-transform group-open:rotate-90">▶</span>
                        <span>{ref.label}</span>
                      </summary>
                      {ref.content && (
                        <div class="px-4 py-3 text-sm border-t border-[var(--color-notion-border)] bg-[var(--color-notion-gray)] max-h-96 overflow-y-auto">
                          <div class="prose prose-sm max-w-none" set:html={ref.content} />
                        </div>
                      )}
                    </details>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <script>
    import { getSubjectProgress } from '../../components/ProgressStore.ts';
    const subjectId = window.location.pathname.split('/')[1] || 'liuyao';
    try {
      const progress = getSubjectProgress(subjectId);
      document.querySelectorAll('[data-milestone-id]').forEach(el => {
        const id = el.dataset.milestoneId!;
        if (progress.completedPaths?.includes(id)) {
          const card = el.querySelector('div:last-child') as HTMLElement;
          if (card) card.classList.add('border-[var(--color-accent)]', 'bg-blue-50');
          const circle = el.querySelector('div:first-child') as HTMLElement;
          if (circle) {
            circle.classList.add('bg-[var(--color-accent)]', 'text-white', 'border-[var(--color-accent)]');
            circle.textContent = '✓';
          }
        }
      });
    } catch (e) {}
  </script>
</SubjectLayout>
