---
import SubjectLayout from '../../layouts/SubjectLayout.astro';
import ProgressBar from '../../components/ProgressBar.astro';

export async function getStaticPaths() {
  return [
    { params: { subject: 'liuyao' } },
    { params: { subject: 'bazi' } },
    { params: { subject: 'yijing' } },
    { params: { subject: 'qimen' } },
    { params: { subject: 'liuren' } },
    { params: { subject: 'fengshui' } },
  ];
}

const { subject } = Astro.params;
const subjectNames: Record<string, string> = {
  liuyao: '六爻',
  bazi: '八字',
  yijing: '易经',
  qimen: '奇门',
  liuren: '六壬',
  fengshui: '风水',
};
const subjectIcons: Record<string, string> = {
  liuyao: '☰', bazi: '⌚', yijing: '☯', qimen: '✦', liuren: '⬡', fengshui: '⌇',
};
const name = subjectNames[subject] ?? subject;
const icon = subjectIcons[subject] ?? '✦';

const menuItems = [
  { label: '路径图', href: `/${subject}/路径图` },
  { label: '练习题', href: `/${subject}/练习题` },
  { label: '案例库', href: `/${subject}/案例库` },
];
---
<SubjectLayout title={name} currentPath={`/${subject}`} sidebarItems={menuItems}>
  <div class="flex items-center gap-3 mb-6">
    <span class="text-4xl">{icon}</span>
    <div>
      <h1 class="text-2xl font-bold">{name}</h1>
    </div>
  </div>

  <!-- Progress summary -->
  <div class="mb-8 p-4 border border-[var(--color-notion-border)] rounded-lg">
    <h2 class="text-sm font-semibold mb-3">本科学步</h2>
    <div id={`progress-${subject}`} data-subject={subject}>
      <ProgressBar value={0} max={100} label="完成度" />
    </div>
    <div class="mt-3 text-xs text-[var(--color-notion-gray-text)]">
      路径节点 0 / 5 已完成 · 练习题 0 / 0 已完成
    </div>
  </div>

  <!-- Navigation cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <a href={`/${subject}/路径图`} class="block p-5 border border-[var(--color-notion-border)] rounded-lg hover:border-[var(--color-accent)] transition-all">
      <div class="text-xl mb-2">🗺️</div>
      <h3 class="font-semibold mb-1">路径图</h3>
      <p class="text-sm text-[var(--color-notion-gray-text)]">里程碑节点与学习素材</p>
    </a>
    <a href={`/${subject}/练习题`} class="block p-5 border border-[var(--color-notion-border)] rounded-lg hover:border-[var(--color-accent)] transition-all">
      <div class="text-xl mb-2">📝</div>
      <h3 class="font-semibold mb-1">练习题</h3>
      <p class="text-sm text-[var(--color-notion-gray-text)]">在线答题，自动批改</p>
    </a>
    <a href={`/${subject}/案例库`} class="block p-5 border border-[var(--color-notion-border)] rounded-lg hover:border-[var(--color-accent)] transition-all">
      <div class="text-xl mb-2">📚</div>
      <h3 class="font-semibold mb-1">案例库</h3>
      <p class="text-sm text-[var(--color-notion-gray-text)]">教学案例与解析</p>
    </a>
  </div>

  <script>
    import { getSubjectProgress } from '../../components/ProgressStore.ts';
    const subjectId = document.currentScript?.dataset.subject || 'liuyao';
    try {
      const progress = getSubjectProgress(subjectId);
      const totalPaths = 8; // six Yao has 8 milestones
      const completed = progress.completedPaths.length;
      const percent = totalPaths > 0 ? Math.round((completed / totalPaths) * 100) : 0;
      const bar = document.querySelector(`#progress-${subjectId} ProgressBar`);
      if (bar) {
        bar.setAttribute('value', String(percent));
        bar.setAttribute('max', '100');
      }
      const statEl = document.querySelector(`#progress-${subjectId}`)?.parentElement?.querySelector('.text-xs');
      if (statEl) {
        const quizCount = Object.keys(progress.quizResults || {}).length;
        statEl.textContent = `路径节点 ${completed} / ${totalPaths} 已完成 · 练习题 ${quizCount} / 0 已完成`;
      }
    } catch(e) {}
  </script>
</SubjectLayout>
