---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  currentPath: string;
  sidebarItems?: Array<{ label: string; href: string }>;
}
const { title, currentPath, sidebarItems = [] } = Astro.props;

// Extract subject from currentPath like /xiuanyan-academy/liuyao or /liuyao
const match = currentPath.match(/\/(liuyao|bazi|yijing|qimen|liuren|fengshui)$/);
const subject = match ? match[1] : 'liuyao';
const BASE = '/xiuanyan-academy';

const defaultItems = [
  { label: '科目介绍', href: `#intro` },
  { label: '路径图', href: `${BASE}/${subject}/路径图` },
  { label: '练习题', href: `${BASE}/${subject}/练习题` },
  { label: '案例库', href: `${BASE}/${subject}/案例库` },
];
const items = sidebarItems.length ? sidebarItems : defaultItems;
---
<BaseLayout title={title}>
  <Header currentPath={currentPath} />
  <div class="max-w-5xl mx-auto px-4 py-8">
    <div class="flex gap-8">
      <!-- Sidebar -->
      <aside class="hidden md:block w-48 flex-shrink-0">
        <nav class="sticky top-20 space-y-1">
          {items.map(item => (
            <a
              href={item.href}
              class="block px-3 py-1.5 text-sm rounded text-[var(--color-notion-gray-text)] hover:bg-[var(--color-notion-gray)] hover:text-[var(--color-notion-text)] transition-colors"
            >
              {item.label}
            </a>
          ))}
        </nav>
      </aside>
      <!-- Content -->
      <main class="flex-1 min-w-0">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>
