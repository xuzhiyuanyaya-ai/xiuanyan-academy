---
// QuizCard.astro - Interactive quiz card with auto-grading
interface Props {
  quizId: string;
  title: string;
  questions: Array<{
    id: string;
    question: string;
    options: string[];
    answer: number;
    explanation: string;
  }>;
  passingScore?: number;
  subjectId: string;
}

const { quizId, title, questions, passingScore = 60, subjectId } = Astro.props;
---

<div class="quiz-card border border-[var(--color-notion-border)] rounded-lg p-6 bg-white" data-quiz-id={quizId} data-subject-id={subjectId}>
  <h3 class="text-lg font-semibold mb-4">{title}</h3>

  <div class="questions space-y-6">
    {questions.map((q, qIdx) => (
      <div class="question" data-question-id={q.id}>
        <p class="font-medium mb-3">{qIdx + 1}. {q.question}</p>
        <div class="options space-y-2">
          {q.options.map((opt, optIdx) => (
            <label class="flex items-start gap-3 p-3 border border-[var(--color-notion-border)] rounded cursor-pointer hover:bg-[var(--color-notion-gray)] transition-colors">
              <input
                type="radio"
                name={`${quizId}-${q.id}`}
                value={optIdx}
                class="mt-0.5"
              />
              <span>{opt}</span>
            </label>
          ))}
        </div>
        <div class="explanation mt-3 hidden p-3 rounded text-sm"></div>
      </div>
    ))}
  </div>

  <div class="mt-6 flex items-center gap-4">
    <button
      class="submit-btn px-4 py-2 bg-[var(--color-accent)] text-white rounded hover:opacity-90 transition-opacity text-sm font-medium"
      disabled
    >
      提交答案
    </button>
    <div class="result hidden text-sm font-medium"></div>
    <div class="ml-auto text-xs text-[var(--color-notion-gray-text)]">
      <span class="attempt-count">首次作答</span>
    </div>
  </div>
</div>

<script>
  import { saveQuizResult, getProgress } from './ProgressStore.ts';

  document.querySelectorAll<HTMLElement>('.quiz-card').forEach(card => {
    const quizId = card.dataset.quizId!;
    const subjectId = card.dataset.subjectId!;
    const submitBtn = card.querySelector<HTMLButtonElement>('.submit-btn')!;
    const resultDiv = card.querySelector<HTMLDivElement>('.result')!;
    const attemptSpan = card.querySelector<HTMLSpanElement>('.attempt-count')!;
    const questions = card.querySelectorAll<HTMLElement>('.question');

    // Enable submit only when all answered
    function checkAllAnswered() {
      let allAnswered = true;
      questions.forEach(q => {
        const checked = q.querySelector<HTMLInputElement>('input:checked');
        if (!checked) allAnswered = false;
      });
      submitBtn.disabled = !allAnswered;
    }

    card.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(input => {
      input.addEventListener('change', checkAllAnswered);
    });

    submitBtn.addEventListener('click', () => {
      let correct = 0;
      const progress = getProgress();
      const existingAttempts = progress.subjects[subjectId]?.quizResults[quizId]?.attempts ?? 0;

      questions.forEach(q => {
        const questionId = q.dataset.questionId!;
        const selected = q.querySelector<HTMLInputElement>('input:checked')?.value;
        const selectedIdx = selected ? parseInt(selected) : -1;
        const opts = q.querySelectorAll<HTMLLabelElement>('.options label');
        const explanation = q.querySelector<HTMLDivElement>('.explanation')!;

        // Find correct answer from DOM (stored in data)
        // We need to pass it via data attribute or find it another way
        // For now, mark correct/incorrect visually
        explanation.classList.remove('hidden');

        // Simple approach: read from the quiz data embedded in page
        // The answer is already available via Astro props, embed in data attribute
      });

      // For now, just save the score (actual grading logic would need answers embedded)
      attemptSpan.textContent = `第 ${existingAttempts + 1} 次作答`;
    });
  });
</script>
