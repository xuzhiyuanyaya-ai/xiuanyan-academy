---
interface Props {
  value: number;
  max?: number;
  label?: string;
  showPercent?: boolean;
}
const { value, max = 100, label, showPercent = true } = Astro.props;
const percent = Math.round((value / max) * 100);
---
<div class="space-y-1">
  {(label || showPercent) && (
    <div class="flex justify-between text-xs text-[var(--color-notion-gray-text)]">
      {label && <span>{label}</span>}
      {showPercent && <span>{percent}%</span>}
    </div>
  )}
  <div class="h-2 bg-[var(--color-notion-gray)] rounded-full overflow-hidden">
    <div
      class="h-full bg-[var(--color-accent)] rounded-full transition-all"
      style={`width: ${percent}%`}
    ></div>
  </div>
</div>
